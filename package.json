{
  "name": "win-track",
  "version": "0.1.2",
  "description": "Get the active window and current browser tab URL in Node.js — native (N-API) for Windows, macOS & Linux. Ideal for time-tracking, productivity and activity-monitoring apps.",
  "license": "MIT",
  "author": "monirsaikat (https://github.com/monirsaikat)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/monirsaikat/win-track.git"
  },
  "bugs": {
    "url": "https://github.com/monirsaikat/win-track/issues"
  },
  "homepage": "https://github.com/monirsaikat/win-track#readme",
  "main": "index.js",
  "types": "index.d.ts",
  "type": "commonjs",
  "engines": {
    "node": ">=16"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "README.md",
    "LICENSE",
    "binding.gyp",
    "src/"
  ],
  "scripts": {
    "install": "node -e \"if (process.platform === 'win32') { require('child_process').execSync('node-gyp rebuild', { stdio: 'inherit' }); }\""
  },
  "keywords": [
    "active-window",
    "active-win",
    "get-active-window",
    "foreground-window",
    "focused-window",
    "current-window",
    "active-app",
    "window-tracker",
    "window-title",
    "browser-url",
    "active-tab-url",
    "current-url",
    "url-tracking",
    "browser-tracking",
    "tab-url",
    "time-tracking",
    "activity-tracking",
    "activity-monitoring",
    "screen-time",
    "productivity",
    "windows",
    "macos",
    "linux",
    "electron",
    "native",
    "n-api",
    "node-api",
    "napi",
    "uiautomation"
  ],
  "dependencies": {
    "node-addon-api": "^7.1.0",
    "node-gyp-build": "^4.6.1"
  }
}
